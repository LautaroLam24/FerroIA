LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
GROQ_API_KEY=
CHAT_HISTORY_WINDOW=10
# Compartido con backend/.env (Nest lo manda como header X-Internal-Token en
# cada request hacia este servicio; sin esto, todas las requests se rechazan)
CHATBOT_INTERNAL_TOKEN=cambiame
# Tool crear_borrador_orden (obs. docente 3): llama al backend Nest con el JWT
# del usuario de la conversación, nunca con una identidad propia.
NEST_API_URL=http://localhost:3000/api
PURCHASE_ORDER_TOOL_TIMEOUT_S=10
# Búsqueda semántica de productos (CU10)
SEMANTIC_SCORE_THRESHOLD=0.2
SEMANTIC_TOP_K=10
