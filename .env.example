# Backend
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ferreteria
JWT_SECRET=cambiame
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
PORT=3000
SEED_ADMIN_EMAIL=admin@ferreteria.local
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_PASSWORD=cambiame
BCRYPT_ROUNDS=10
# Chatbot
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
GROQ_API_KEY=
CHATBOT_URL=http://localhost:8001
CHATBOT_TIMEOUT_MS=15000
CHAT_HISTORY_WINDOW=10
# Secreto compartido entre Nest y el servicio Python (header X-Internal-Token):
# sin esto, /chat y el resto de los endpoints de chatbot/api.py rechazan todo.
CHATBOT_INTERNAL_TOKEN=cambiame
# Órdenes de compra vía asistente (tool crear_borrador_orden, obs. docente 3)
NEST_API_URL=http://localhost:3000/api
PURCHASE_ORDER_TOOL_TIMEOUT_S=10
# Búsqueda semántica y reposición (CU10, reusa el servicio de chatbot)
SEMANTIC_SCORE_THRESHOLD=0.2
SEMANTIC_TOP_K=10
RESTOCK_PERIOD_DAYS=30
RESTOCK_LEAD_DAYS=15
